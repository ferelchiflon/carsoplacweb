# ============================================================
# Carsoplac Backend - Variables de Entorno (PLANTILLA)
# ============================================================
# ⚠️  NUNCA subir el archivo .env real al repositorio.
# ⚠️  Este archivo SOLO documenta qué variables se esperan.
# ⚠️  El archivo real (carsoplac-back/.env) está en .gitignore.
# ============================================================

# --- Entorno ---
NODE_ENV=production
PORT=3000

# --- Base de Datos (PostgreSQL) ---
# Generada por DATABASE_URL al levantar docker-compose
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://carsoplac_app:CHANGE_ME_DB_PASS@postgres:5432/carsoplac_prod?schema=public

# --- JWT (CRÍTICO: rotar antes de producción) ---
# Mínimo 64 caracteres hex (32 bytes). Generar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REEMPLAZAR_CON_CRYPTO_RANDOM_BYTES_64_HEX
JWT_EXPIRES_IN=12h

# --- MercadoPago (CRÍTICO: rotar en el panel de MP) ---
# Access Token PRODUCCIÓN. Nunca usar TEST en producción.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-REEMPLAZAR-CON-TOKEN-PRODUCTION

# --- Cloudinary (CRÍTICO: rotar desde el dashboard de Cloudinary) ---
CLOUDINARY_CLOUD_NAME=REEMPLAZAR_CLOUD_NAME
CLOUDINARY_API_KEY=REEMPLAZAR_API_KEY
CLOUDINARY_API_SECRET=REEMPLAZAR_API_SECRET

# --- CORS ---
# Orígenes separados por coma. NO usar "*" en producción.
CORS_ORIGINS=https://carsoplac.com.ar,https://admin.carsoplac.com.ar

# --- Admin Seed (sólo primer deploy / rotación) ---
# Contraseña temporal del admin inicial. Cambiar tras primer login.
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURA_MIN_16_CHARS
